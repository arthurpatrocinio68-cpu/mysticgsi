ro.build.system_root_image=true
ro.support_one_handed_mode=true
persist.sys.binary_xml=false
persist.logd.logpersistd.buffer=0
ro.opengles.version=196610
persist.sys.disable_rescue=true
ro.control_privapp_permissions=disable
ro.cp_system_other_odex=0
ro.nnapi.extensions.deny_on_product=true

# Force ADB
persist.sys.usb.config=adb,mtp
ro.adb.secure=0
ro.secure=0
ro.debuggable=1

# Some devices have sdcardfs kernel panicing on 8.0, Disable for everyone for the moment
ro.sys.sdcardfs=0

# Lenovo TB311FU spoofing
ro.product.brand=Lenovo
ro.product.manufacturer=LENOVO
ro.product.model=Lenovo TB311FU
ro.product.device=greevil
ro.product.name=TB311FU_ROW
ro.build.product=greevil
ro.build.description=TB311FU_ROW-user 13 TQ3A.230801.002 V14.0.480_ST_230919 release-keys
ro.build.fingerprint=Lenovo/TB311FU_ROW/greevil:13/TQ3A.230801.002/V14.0.480_ST_230919:user/release-keys
